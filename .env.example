# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
#
#   cp .env.example .env
#
# Anything already set in the real environment wins over this file, so CI and
# containers can inject credentials without touching .env.

# Where xg.py and predict_weather.py read observations from: csv | db
DATA_SOURCE=db

# --- PostgreSQL -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weather_predict
DB_USER=weather_predict_app
DB_PASSWORD=
DB_SCHEMA=weather_predict_db


# libpq sslmode: disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=prefer

# Alternative to the six settings above; wins over them when set.
# DATABASE_URL=postgresql://user:password@host:5432/weather_predict

# --- Rollup knobs -----------------------------------------------------------
# Timezone the day boundary is drawn in when wx_data.dtg is rolled up to daily
# rows. UTC keeps every city on one clock; a single-city database may prefer
# its own local zone (e.g. America/New_York).
DB_TIMEZONE=UTC

# Skip city-days with fewer than this many temperature readings -- a day with
# one reading out of 24 gives a meaningless daily max/min. Leave at 1 if the
# database stores one already-aggregated row per day.
DB_MIN_OBS_PER_DAY=1

# cities stores names but no coordinates, so the database path looks each city's
# latitude/longitude up here, by folded name. Written by fetch_weather.py.
CITY_COORDINATES=geocode_cache.json
DB_NAME='agile_db'
DB_USER=<username>
DB_PASSWORD=<password>
DB_HOST='db.cecs.pdx.edu'
DB_PORT=5432
