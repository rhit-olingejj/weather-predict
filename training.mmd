---
title: XGBoost training process — xg.py
---
flowchart TD
    CSV[("weather_daily.csv<br/>daily observations · 5 cities · 2020-2024")]
    LOAD["load_raw()<br/>parse dates · sort by city, date · drop duplicate city+date"]
    FEAT["build_features()<br/>one row per city and day D<br/>today · lags 1,2,3,7 · trailing 3,7,14,30 · momentum<br/>place · season of D+1 · condition one-hots"]
    WARM["drop warm-up rows<br/>first 29 days per city lack a full 30-day window"]
    LAB["drop rows with no next-day observation<br/>LabelEncoder on y_condition"]
    XY["X = numeric feature columns<br/>y = y_temp_mean_c · y_is_wet · y_condition_code"]
    SPLIT["Train_validate_test_split()<br/>random 64 / 16 / 20 · random_state 42"]

    TRAIN["train"]
    VAL["validate"]
    TEST["test"]

    subgraph per ["search() — once per target, 10 candidates each"]
        FIT["fit candidate on train<br/>early_stopping_rounds = 50<br/>budget = n_estimators, 60 to 2500"]
        EVAL["score on validation<br/>keep best_iteration · flag if the budget bound"]
        RANK["rank candidates by one metric<br/>temperature: MAE · precipitation: log loss<br/>condition: log loss"]
        WIN["winner — kept as fitted, not refit"]
    end

    subgraph tgt ["three targets, one feature matrix"]
        R["XGBRegressor<br/>reg:squarederror · eval MAE"]
        B["XGBClassifier<br/>binary:logistic · eval log loss"]
        M["XGBClassifier<br/>multi:softprob · eval mlogloss"]
    end

    SCORE["score winners once on test<br/>vs. persistence and majority-class baselines"]
    BUNDLE[("models/xgb_weather.joblib<br/>3 boosters + feature schema + classes + metrics")]
    SERVE["predict_weather.py<br/>temperature_c · precipitation probability<br/>condition + class distribution"]

    CSV --> LOAD --> FEAT --> WARM --> LAB --> XY --> SPLIT
    SPLIT --> TRAIN
    SPLIT --> VAL
    SPLIT --> TEST
    TRAIN -->|fit| FIT
    VAL -->|early stopping + ranking| FIT
    FIT --> EVAL
    EVAL -->|next candidate| FIT
    EVAL --> RANK --> WIN
    WIN --> R
    WIN --> B
    WIN --> M
    R --> SCORE
    B --> SCORE
    M --> SCORE
    TEST -->|never seen during selection| SCORE
    SCORE --> BUNDLE --> SERVE

    classDef data fill:#e8eef7,stroke:#4a6fa5,color:#1a2a3a
    classDef split fill:#eef3e8,stroke:#6a8f4a,color:#1a2a3a
    classDef model fill:#f7efe4,stroke:#b07d3a,color:#2a1f10
    class CSV,BUNDLE data
    class TRAIN,VAL,TEST split
    class R,B,M,SCORE,SERVE model
